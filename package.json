{
	"name": "djs-commands",
	"version": "0.0.0",
	"description": "Modern Discord.js command handler — TypeScript-first, Components V2 native, with pluggable persistence",
	"author": "D3OXY <hello@deoxy.dev>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/D3OXY/djs-commands.git"
	},
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.0.0",
		"bun": ">=1.2.0"
	},
	"packageManager": "bun@1.2.20",
	"workspaces": {
		"packages": [
			"packages/*",
			"apps/*",
			"examples/*"
		],
		"catalog": {
			"typescript": "^5.9.3",
			"@types/node": "^22.0.0",
			"@types/bun": "^1.2.20",
			"@types/react": "^19.2.14",
			"@types/react-dom": "^19.2.3",
			"discord.js": "^14.26.0",
			"react": "^19.2.0",
			"react-dom": "^19.2.0"
		}
	},
	"scripts": {
		"build": "turbo build",
		"build:docs": "turbo build --filter=docs",
		"dev": "turbo dev",
		"dev:docs": "turbo dev --filter=docs",
		"typecheck": "turbo typecheck",
		"check": "biome check",
		"check:write": "biome check --write",
		"knip": "knip",
		"test": "turbo test",
		"ci": "bun run check && bun run typecheck && bun run knip && bun run test",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "turbo build --filter='@djs-commands/*' --filter='create-djs-commands' && changeset publish",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@changesets/cli": "^2.27.0",
		"husky": "^9.1.7",
		"knip": "^5.71.0",
		"turbo": "^2.7.2",
		"typescript": "^5.9.3"
	}
}
