		"typescript": "catalog:"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/D3OXY/djs-commands.git",
		"directory": "packages/adapter-redis"
	},
	"keywords": [
		"discord.js",
		"discord",
		"redis",
		"ioredis",
